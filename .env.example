# Runtime
APP_ENV=development
LOG_LEVEL=DEBUG
KNOWLEDGE_PORT=8001
BROWSER_PORT=8002

# OpenAI API (ChatGPT Plus does not provide this API quota)
OPENAI_API_KEY=replace-with-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_AGENT_MODEL=gpt-6-luna
AGENT_MODEL=gpt-6-luna
AGENT_REASONING_EFFORT=low

# Knowledge / MCP Service
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8001
KNOWLEDGE_DATA_DIR=/app/data
MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters
BROWSER_EXECUTOR_BASE_URL=http://browser-executor-service:8000
BROWSER_API_TOKEN=replace-with-a-different-browser-api-token
BROWSER_REQUEST_TIMEOUT_SECONDS=180

# Browser Executor Service
BROWSER_PUBLIC_BASE_URL=http://localhost:8002
BROWSER_DATA_DIR=/app/data
START_URL=https://replace-with-raydium-official-homepage.example/
ALLOWED_DOMAIN=replace-with-raydium-official-domain.example
MAX_PAGES=5
MAX_DAILY_BROWSER_RUNS=20
MAX_CONCURRENT_BROWSER_RUNS=1
